set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_VERSION 1)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

find_program(ARM_NONE_EABI_GCC arm-none-eabi-gcc REQUIRED)
get_filename_component(ARM_NONE_EABI_BIN_DIR "${ARM_NONE_EABI_GCC}" DIRECTORY)
find_program(ARM_NONE_EABI_GXX arm-none-eabi-g++ HINTS "${ARM_NONE_EABI_BIN_DIR}" REQUIRED)
find_program(ARM_NONE_EABI_AR arm-none-eabi-ar HINTS "${ARM_NONE_EABI_BIN_DIR}" REQUIRED)
find_program(ARM_NONE_EABI_OBJCOPY arm-none-eabi-objcopy HINTS "${ARM_NONE_EABI_BIN_DIR}" REQUIRED)
find_program(ARM_NONE_EABI_SIZE arm-none-eabi-size HINTS "${ARM_NONE_EABI_BIN_DIR}" REQUIRED)

set(CMAKE_C_COMPILER "${ARM_NONE_EABI_GCC}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${ARM_NONE_EABI_GXX}" CACHE FILEPATH "" FORCE)
set(CMAKE_ASM_COMPILER "${ARM_NONE_EABI_GCC}" CACHE FILEPATH "" FORCE)
set(CMAKE_AR "${ARM_NONE_EABI_AR}" CACHE FILEPATH "" FORCE)
set(CMAKE_OBJCOPY "${ARM_NONE_EABI_OBJCOPY}" CACHE FILEPATH "" FORCE)
set(CMAKE_SIZE "${ARM_NONE_EABI_SIZE}" CACHE FILEPATH "" FORCE)

set(CMAKE_FIND_ROOT_PATH "${ARM_NONE_EABI_BIN_DIR}/../arm-none-eabi")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
