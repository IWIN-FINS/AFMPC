{
  "transport": {
    "type": "tcp",
    "host": "127.0.0.1",
    "port": 5000,
    "timeout_sec": 0.2,
    "reconnect_interval_sec": 1,
    "serial_port": "/dev/ttyUSB0",
    "baudrate": 115200,
    "bind_host": "0.0.0.0",
    "bind_port": 54321,
    "remote_host": "192.0.2.2",
    "remote_port": 58766
  },
  "control": {
    "period_sec": 0.05,
    "telemetry_max_age_sec": 0.25,
    "confirmation_max_age_sec": 0.25,
    "depth_rate_filter_tau_sec": 0.25,
    "max_abs_heave_rate_m_s": 1
  },
  "hardware_adapter": {
    "positive_force_at_limit": [
      20,
      15,
      15
    ],
    "translation_channel_limits": [
      0.35,
      0.35,
      0.5
    ],
    "translation_signs": [
      1,
      1,
      1
    ],
    "positive_yaw_moment_at_limit": 4,
    "yaw_channel_limit": 0.2,
    "yaw_sign": 1
  },
  "vision": {
    "range_reference_m": 0.5,
    "target_width_at_reference_px": 90,
    "horizontal_half_fov_deg": 42,
    "vertical_half_fov_deg": 30,
    "width_filter_length": 6,
    "desired_range_m": 0.8,
    "range_deadband_m": 0.04,
    "forward_force_gain_n_m": 12,
    "forward_force_limit_n": 8,
    "depth_correction_gain": 1,
    "max_depth_correction_m": 0.35,
    "max_measurement_age_s": 0.25
  },
  "video": {
    "sample_timeout_sec": 0.01,
    "pipeline": "udpsrc port=5600 ! application/x-rtp,encoding-name=H264,payload=96 ! rtpjitterbuffer latency=40 ! rtph264depay ! avdec_h264 ! videoconvert ! video/x-raw,format=BGR ! appsink name=mysink max-buffers=1 drop=true"
  }
}
